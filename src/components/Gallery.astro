---
import type { ResponsiveImage } from "../lib/smugmug";
import SmugMugImage from "./SmugMugImage.astro";

interface Props {
  images: ResponsiveImage[];
}

const { images } = Astro.props;
const gridSizes = "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw";
---

<!-- Masonry via CSS grid + row-span: items are placed left-to-right in DOM order
     (preserving the original upload order), and a script sizes each item's row span
     to its natural height so columns pack tightly. Photos keep their aspect ratio,
     so vertical photos display tall (favoring portrait orientation). -->
<div class="masonry grid grid-cols-1 gap-x-6 gap-y-0 [grid-auto-rows:1px] sm:grid-cols-2 lg:grid-cols-3">
  {
    images.map((image, i) => {
      // Approximate row span from the intrinsic aspect ratio (~475px reference column
      // width) so items are roughly laid out before JS runs — this prevents the
      // pre-layout "cram" that would otherwise make the reveal observer reveal every
      // item at once. The inline script below refines each span to the exact height.
      const estRows = (image.width ? Math.round((475 * image.height) / image.width) : 400) + 24;
      return (
        <button
          type="button"
          class="masonry-item lightbox-trigger reveal group relative block w-full self-start overflow-hidden bg-stone-light"
          style={`grid-row-end: span ${estRows}`}
          data-src={image.src}
          data-srcset={image.srcset}
          data-alt={image.alt}
          aria-label={`View larger image: ${image.alt}`}
        >
          <SmugMugImage
            image={image}
            sizes={gridSizes}
            priority={i < 3}
            class="h-auto w-full transition-transform duration-300 group-hover:scale-105"
          />
        </button>
      );
    })
  }
</div>

<dialog
  id="lightbox"
  class="m-auto max-h-[90vh] max-w-[95vw] overflow-hidden bg-transparent p-0 backdrop:bg-ink/90"
>
  <button
    type="button"
    id="lightbox-close"
    class="absolute right-3 top-3 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-paper/90 text-xl leading-none"
    aria-label="Close"
  >
    &times;
  </button>
  <img id="lightbox-image" src="" alt="" class="max-h-[90vh] max-w-[95vw] object-contain" />
</dialog>

<!-- Inline (not a bundled module) so it runs during parse — BEFORE the end-of-body
     scroll-reveal observer in BaseLayout. Otherwise the observer would evaluate item
     positions while they're still crammed at the top (pre-layout), see them all "in
     view", and reveal everything at once (killing the scroll animation). -->
<script is:inline>
  (function () {
    // Masonry: size each item's grid row span to its height so items pack tightly
    // while keeping DOM (upload) order. Rows are 1px (see [grid-auto-rows:1px]); the
    // 24px value bakes in the vertical gap below each item.
    var GAP = 24;

    function layoutMasonry() {
      document.querySelectorAll(".masonry").forEach(function (grid) {
        grid.querySelectorAll(".masonry-item").forEach(function (item) {
          var span = Math.ceil(item.getBoundingClientRect().height + GAP);
          item.style.gridRowEnd = "span " + span;
        });
      });
    }

    var resizeTimer;
    window.addEventListener("resize", function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(layoutMasonry, 150);
    });

    // Recompute once images finish loading (in case any lack intrinsic dimensions)
    // and after full load. Intrinsic width/height keep the first pass correct.
    document.querySelectorAll(".masonry img").forEach(function (img) {
      if (!img.complete) img.addEventListener("load", layoutMasonry, { once: true });
    });
    window.addEventListener("load", layoutMasonry);
    layoutMasonry();
  })();
</script>

<script>
  const dialog = document.getElementById("lightbox") as HTMLDialogElement | null;
  const lightboxImage = document.getElementById("lightbox-image") as HTMLImageElement | null;
  const closeBtn = document.getElementById("lightbox-close");

  document.querySelectorAll<HTMLButtonElement>(".lightbox-trigger").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      if (!dialog || !lightboxImage) return;
      lightboxImage.src = trigger.dataset.src ?? "";
      lightboxImage.srcset = trigger.dataset.srcset ?? "";
      lightboxImage.sizes = "95vw";
      lightboxImage.alt = trigger.dataset.alt ?? "";
      dialog.showModal();
    });
  });

  closeBtn?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
