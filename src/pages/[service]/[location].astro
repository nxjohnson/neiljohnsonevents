---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Gallery from "../../components/Gallery.astro";
import { services, locations, buildLandingCopy } from "../../config/seo";
import { getGalleryBySlug } from "../../config/galleries";
import { getGalleryImages } from "../../lib/smugmug";

export async function getStaticPaths() {
  return services.flatMap((service) =>
    locations.map((location) => ({
      params: { service: service.slug, location: location.slug },
      props: { service, location },
    }))
  );
}

const { service, location } = Astro.props;
const { title, description, intro } = buildLandingCopy(service, location);

const gallery = getGalleryBySlug(service.gallerySlug);
const allImages = gallery ? await getGalleryImages(gallery.albumKey, `${service.label} photo`) : [];
const previewImages = allImages.slice(0, 6);

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: title,
  description,
  areaServed: { "@type": "AdministrativeArea", name: `${location.label}, CA` },
  provider: {
    "@type": "ProfessionalService",
    name: "Neil Johnson Events",
    url: "https://www.neiljohnsonevents.com",
  },
};
---

<BaseLayout title={title} description={description} image={previewImages[0]?.src} schema={schema}>
  <section class="gutter py-16 sm:py-24" data-reveal-group>
    <h1 class="reveal font-display text-3xl sm:text-5xl">{title}</h1>
    <p class="reveal mt-4 max-w-2xl text-stone">{intro}</p>
    <a
      href="/contact"
      class="btn-primary reveal mt-6"
    >
      Reserve Your Date
    </a>
  </section>

  <section class="gutter pb-16 sm:pb-24">
    {
      previewImages.length > 0 ? (
        <Gallery images={previewImages} />
      ) : (
        <p class="py-8 text-center text-stone">Gallery coming soon.</p>
      )
    }
    {
      gallery && (
        <div class="reveal mt-8 text-center">
          <a
            href={`/portfolio/${gallery.slug}`}
            class="border-b border-ink pb-1 text-sm uppercase tracking-wider transition-colors hover:border-accent hover:text-accent"
          >
            View Full {gallery.label} Portfolio
          </a>
        </div>
      )
    }
  </section>
</BaseLayout>
