---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Get in touch to book wedding, corporate event, conference, or headshot photography across Los Angeles County and Orange County."
>
  <section class="gutter py-16 sm:py-24" data-reveal-group>
    <h1 class="reveal font-display text-3xl sm:text-5xl">Let&rsquo;s Chat!</h1>
    <p class="reveal mt-3 max-w-2xl text-stone">
      I&rsquo;m so excited that you&rsquo;re interested in working with me! Tell me all about
      yourself, the type of photography you&rsquo;re looking for, as much detail as you can provide,
      and any questions you have. Can&rsquo;t wait to hear from you!
    </p>

    <form id="contact-form" class="reveal mt-8 max-w-2xl space-y-5">
      <div>
        <label for="name" class="field-label">
          Name <span class="text-accent">*</span>
        </label>
        <input
          id="name"
          name="name"
          type="text"
          required
          class="field-input"
        />
      </div>

      <div>
        <label for="email" class="field-label">
          Email <span class="text-accent">*</span>
        </label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="field-input"
        />
      </div>

      <div>
        <label for="phone" class="field-label">
          Phone <span class="text-accent">*</span>
        </label>
        <input
          id="phone"
          name="phone"
          type="tel"
          required
          class="field-input"
        />
      </div>

      <div>
        <label for="eventDate" class="field-label">
          Event Date <span class="text-accent">*</span>
        </label>
        <input
          id="eventDate"
          name="eventDate"
          type="date"
          required
          class="field-input"
        />
      </div>

      <div>
        <label for="eventType" class="field-label">
          Event Type <span class="text-accent">*</span>
        </label>
        <select
          id="eventType"
          name="eventType"
          required
          class="field-input"
        >
          <option value="">Select an option</option>
          <option value="Wedding">Wedding</option>
          <option value="Corporate Event">Corporate Event</option>
          <option value="Conference">Conference</option>
          <option value="Headshots">Headshots</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div>
        <label for="location" class="field-label">
          Location <span class="text-accent">*</span>
        </label>
        <input
          id="location"
          name="location"
          type="text"
          required
          class="field-input"
        />
      </div>

      <div>
        <label for="howHeard" class="field-label">How did you hear about me?</label>
        <input
          id="howHeard"
          name="howHeard"
          type="text"
          class="field-input"
        />
      </div>

      <div>
        <label for="message" class="field-label">
          Message <span class="text-accent">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="field-input"
        ></textarea>
      </div>

      <button type="submit" class="btn-primary w-full sm:w-auto"> Submit </button>

      <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
    </form>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status) return;

    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    submitBtn?.setAttribute("disabled", "true");
    status.textContent = "Sending...";
    status.className = "text-sm text-stone";

    try {
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!res.ok) throw new Error("Request failed");

      status.textContent = "Thank you! I'll be in touch shortly.";
      status.className = "text-sm text-accent";
      form.reset();
    } catch {
      status.textContent = "Something went wrong sending your message. Please try again.";
      status.className = "text-sm text-red-600";
    } finally {
      submitBtn?.removeAttribute("disabled");
    }
  });
</script>
