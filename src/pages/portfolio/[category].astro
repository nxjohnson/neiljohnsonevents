---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Gallery from "../../components/Gallery.astro";
import { galleries } from "../../config/galleries";
import { getGalleryImages } from "../../lib/smugmug";

export async function getStaticPaths() {
  return galleries.map((g) => ({ params: { category: g.slug }, props: { gallery: g } }));
}

const { gallery } = Astro.props;
const images = await getGalleryImages(gallery.albumKey, `${gallery.label} photo`);

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: gallery.heading,
  description: gallery.description,
};
---

<BaseLayout
  title={`${gallery.heading} | Los Angeles &amp; Orange County`}
  description={gallery.description}
  image={images[0]?.src}
  schema={schema}
>
  <section class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <h1 class="font-display text-3xl sm:text-5xl">{gallery.heading}</h1>
    <p class="mt-3 max-w-2xl text-stone">{gallery.description}</p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16 sm:px-8 sm:pb-24">
    {
      images.length > 0 ? (
        <Gallery images={images} />
      ) : (
        <p class="py-12 text-center text-stone">
          Gallery coming soon — connect this category to a SmugMug album in
          <code class="mx-1 rounded bg-stone-light px-1.5 py-0.5">src/config/galleries.ts</code>.
        </p>
      )
    }
  </section>
</BaseLayout>
