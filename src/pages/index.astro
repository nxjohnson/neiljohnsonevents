---
import BaseLayout from "../layouts/BaseLayout.astro";
import SmugMugImage from "../components/SmugMugImage.astro";
import { galleries, type GalleryCategory } from "../config/galleries";
import { getGalleryImages } from "../lib/smugmug";

const galleryImages = await Promise.all(
  galleries.map((g) => getGalleryImages(g.albumKey, `${g.label} photo`))
);

// Pinned by SmugMug's permanent ImageKey (not array position) so these stay put
// even if an album is reordered, images are added, or images are removed.
const PINNED_IMAGE_KEYS: Record<GalleryCategory["slug"], string> = {
  weddings: "d6nGnqZ", // #30 — 30_01-Cass-Winery-Paso-Robles-Wedding-Photography.jpg
  events: "ntbbBm3", // #1 — 01_01-Las-Vegas-Nevada-Concert-Photography.jpg
  headshots: "jp67F4C", // #15 — 15_02-Los-Angeles-County-Business-Headshot-Photography.jpg
};

function pinnedImage(slug: GalleryCategory["slug"], images: (typeof galleryImages)[number]) {
  const key = PINNED_IMAGE_KEYS[slug];
  return images.find((img) => img.key === key) ?? images[0];
}

const tileImages = galleries.map((g, i) => ({
  category: g,
  image: pinnedImage(g.slug, galleryImages[i]),
}));

const weddingImages = galleryImages[galleries.findIndex((g) => g.slug === "weddings")] ?? [];
const hero = pinnedImage("weddings", weddingImages);

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Neil Johnson Events",
  description:
    "Wedding, corporate event, conference, and headshot photography across Los Angeles County and Orange County.",
  areaServed: ["Los Angeles County, CA", "Orange County, CA"],
  url: "https://www.neiljohnsonevents.com",
};
---

<BaseLayout
  title="Los Angeles &amp; Orange County Wedding, Event &amp; Headshot Photographer"
  description="Neil Johnson Events — wedding, corporate event, conference, and headshot photography across Los Angeles County and Orange County."
  schema={schema}
>
  <!-- Hero -->
  <section class="relative flex min-h-[70vh] items-end sm:min-h-[85vh]">
    {
      hero ? (
        <SmugMugImage
          image={hero}
          priority
          sizes="100vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
      ) : (
        <div class="absolute inset-0 bg-gradient-to-b from-stone-light to-stone" />
      )
    }
    <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/10 to-transparent"></div>

    <div class="relative z-10 mx-auto w-full max-w-6xl px-5 pb-12 sm:px-8 sm:pb-16">
      <h1 class="max-w-xl font-display text-4xl leading-tight text-paper sm:text-6xl">
        Wedding &amp; Event Photography in Los Angeles &amp; Orange County
      </h1>
      <p class="mt-4 max-w-md text-paper/90">
        Capturing your moments with a blend of creativity and precision.
      </p>
      <a
        href="/contact"
        class="mt-6 inline-block bg-paper px-6 py-3 text-sm uppercase tracking-wider text-ink transition-colors hover:bg-accent hover:text-paper"
      >
        Reserve Your Date
      </a>
    </div>
  </section>

  <!-- About blurb -->
  <section class="mx-auto max-w-3xl px-5 py-16 text-center sm:px-8 sm:py-24">
    <h2 class="font-display text-3xl sm:text-4xl">A Blend of Creativity &amp; Precision</h2>
    <p class="mt-4 text-stone">
      Based in Los Angeles County, Neil Johnson Events photographs weddings, corporate events,
      conferences, and headshots throughout LA and Orange County — striving to capture every
      moment authentically.
    </p>
    <a
      href="/about"
      class="mt-6 inline-block border-b border-ink pb-1 text-sm uppercase tracking-wider transition-colors hover:border-accent hover:text-accent"
    >
      Learn More
    </a>
  </section>

  <!-- Category tiles -->
  <section class="px-5 pb-16 sm:px-8 sm:pb-24">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-3 sm:grid-cols-3">
      {
        tileImages.map(({ category, image }) => (
          <a
            href={`/portfolio/${category.slug}`}
            class="group relative block aspect-[4/5] overflow-hidden bg-stone-light"
          >
            {image ? (
              <SmugMugImage
                image={image}
                sizes="(min-width: 640px) 33vw, 100vw"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            ) : (
              <div class="h-full w-full bg-stone-light" />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-transparent" />
            <span class="absolute bottom-4 left-4 font-display text-2xl text-paper sm:bottom-6 sm:left-6 sm:text-3xl">
              {category.label}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Testimonial -->
  <section class="bg-ink px-5 py-16 text-center text-paper sm:px-8 sm:py-24">
    <blockquote class="mx-auto max-w-2xl">
      <p class="font-display text-2xl leading-relaxed sm:text-3xl">
        &ldquo;From start to finish, the experience was nothing short of amazing.&rdquo;
      </p>
      <footer class="mt-4 text-sm uppercase tracking-wider text-paper/70">
        — Laboni &amp; Matthew
      </footer>
    </blockquote>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-3xl px-5 py-16 text-center sm:px-8 sm:py-24">
    <h2 class="font-display text-3xl sm:text-4xl">Reserve Your Date</h2>
    <p class="mt-4 text-stone">
      Booking weddings, events, conferences, and headshot sessions across LA and Orange County.
    </p>
    <a
      href="/contact"
      class="mt-6 inline-block bg-ink px-6 py-3 text-sm uppercase tracking-wider text-paper transition-colors hover:bg-accent"
    >
      Contact Me
    </a>
  </section>
</BaseLayout>
