---
import BaseLayout from "../layouts/BaseLayout.astro";
import SmugMugImage from "../components/SmugMugImage.astro";
import { getGalleryImages } from "../lib/smugmug";

// Misc gallery (https://clients.neiljohnsonevents.com/Website/Misc) — one-off photos
// that don't belong to a portfolio category.
const MISC_ALBUM_KEY = "qQfB7n";
const PORTRAIT_IMAGE_KEY = "VDgHpzz"; // 1_2-Neil-Johnson.jpg
const miscImages = await getGalleryImages(MISC_ALBUM_KEY, "Neil Johnson");
const portrait = miscImages.find((img) => img.key === PORTRAIT_IMAGE_KEY);
---

<BaseLayout
  title="About"
  description="Meet Neil Johnson — wedding, corporate event, conference, and headshot photographer serving Los Angeles County and Orange County."
>
  <section class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-24">
    <h1 class="font-display text-3xl sm:text-5xl">About Neil</h1>

    <div class="mt-8 sm:flex sm:items-start sm:gap-8">
      {
        portrait && (
          <SmugMugImage
            image={portrait}
            sizes="(min-width: 640px) 256px, 60vw"
            class="mb-6 w-40 object-cover sm:mb-0 sm:w-64 sm:flex-shrink-0"
          />
        )
      }
      <div class="space-y-4 text-stone">
        <p>
          Hello there! I'm Neil, an experienced event photographer located in Los Angeles County, California. With over a decade of shooting diverse and exhilarating events, I've developed a keen eye for capturing those special moments..
        </p>
        <p>
          My primary objective is to document and preserve the essence of your event. I understand the immense effort and dedication that goes into organizing and executing a successful gathering. That's why I'm here to provide you with top-notch photography that not only showcases your achievements but also ensures that your attendees will cherish the memories forever.
        </p>
        <p>
          Allow me to be your trusted visual storyteller, encapsulating the unique narrative of your event through my high-quality imagery. With my expertise, you can relive the excitement, beauty, and emotions of your special occasion time and time again.
        </p>
        <p>
          Get in touch with me today, and let's collaborate to create a photographic legacy for your event.
        </p>
      </div>
    </div>

    <a
      href="/contact"
      class="mt-8 inline-block bg-ink px-6 py-3 text-sm uppercase tracking-wider text-paper transition-colors hover:bg-accent"
    >
      Get In Touch
    </a>
  </section>
</BaseLayout>
